# =============================================================================
# ExitStudio · Plantilla de entorno (valores pensados para PRODUCCIÓN)
# Copia a .env y rellena los valores marcados con <...>.
# En local: APP_ENV=local, APP_DEBUG=true, APP_URL=http://127.0.0.1:8000,
#           FILAMENT_DOMAIN= (vacío -> panel en /admin), SESSION_DOMAIN=null,
#           SESSION_SECURE_COOKIE=false.
# =============================================================================

APP_NAME="ExitStudio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://exitstudio.es

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Base de datos -----------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<exitstudio>
DB_USERNAME=<usuario>
DB_PASSWORD=<contraseña>

# --- Sesión y cookies --------------------------------------------------------
# '.exitstudio.es' comparte la cookie entre exitstudio.es y admin.exitstudio.es.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.exitstudio.es
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Panel de administración (Filament) --------------------------------------
# Subdominio del panel. Vacío = panel en APP_URL/FILAMENT_PATH.
FILAMENT_DOMAIN=admin.exitstudio.es
FILAMENT_PATH=admin

# Primer administrador: php artisan db:seed --class=AdminUserSeeder --force
# Borra ADMIN_PASSWORD de este archivo después de crear el usuario.
ADMIN_NAME="Administrador"
ADMIN_EMAIL=<admin@exitstudio.es>
ADMIN_PASSWORD=

# --- Archivos y optimización de medios ---------------------------------------
# Requiere: php artisan storage:link
FILESYSTEM_DISK=public
MEDIA_DISK=public
MEDIA_AVIF=true
MEDIA_WEBP_QUALITY=80
MEDIA_AVIF_QUALITY=60

# --- Colas y caché -----------------------------------------------------------
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Correo (avisos del formulario de contacto) ------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp.proveedor.com>
MAIL_PORT=587
MAIL_USERNAME=<usuario-smtp>
MAIL_PASSWORD=<contraseña-smtp>
MAIL_FROM_ADDRESS="hola@exitstudio.es"
MAIL_FROM_NAME="${APP_NAME}"
# Buzón que recibe los mensajes de /contactos.
CONTACT_MAIL_TO="hola@exitstudio.es"
CONTACT_MIN_SECONDS=3
CONTACT_MAX_PER_MINUTE=3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#php artisan db:seed --class=AdminUserSeeder --force
