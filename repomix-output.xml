<file path="storage/sass-backup/sass/global/_btn-base.scss">
@use 'variables' as *;

button {
    font-family: inherit;
    cursor: pointer;
    border: none;
    background: none;
}

// Botones reutilizables
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.75rem;
    border-radius: 62.4375rem;
    font-weight: 600;
    font-size: 0.95rem;
    transition: transform 0.3s $ease-out-expo, background-color 0.3s ease, box-shadow 0.3s ease;

    &--primary {
        background-color: $color-ink;
        color: $color-bg;

        &:hover {
            background-color: $color-terracotta;
            transform: translateY(-2px);
        }
    }

    &--outline {
        border: 1.5px solid $color-ink;
        color: $color-ink;

        &:hover {
            background-color: $color-ink;
            color: $color-bg;
        }
    }
}
</file>

<file path="storage/sass-backup/sass/global/_fonts.scss">

</file>

<file path="storage/sass-backup/sass/global/_global.scss">
@use 'variables' as *;

*,
*::before,
*::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
}

body.studio-body {
    background-color: $color-bg;
    color: $color-ink;
    font-family: $font-sans;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

.container {
    width: 100%;
    max-width: $container-max;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
}
//======================= Funcionalidas generales =======================
img {
    display: block;
    max-width: 100%;
    height: auto;
}

a {
    color: inherit;
    text-decoration: none;
}

//======================= Cabecera de secciones =======================
.section-header {
    max-width: 640px;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);

    &__eyebrow {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: $color-terracotta;
        margin-bottom: 0.75rem;
    }

    &__title {
        font-family: $font-display;
        font-size: clamp(2rem, 4vw, 3.1rem);
        font-weight: 400;
        line-height: 1.15;
        margin-bottom: 1rem;
    }

    &__desc {
        color: $color-ink-muted;
        font-size: 1.05rem;
    }
}
//======================= Animación Reveal =======================
[data-reveal] {
    opacity: 0;
    transform: translateY(1.5rem);
    transition: opacity 0.8s $ease-out-expo, transform 0.8s $ease-out-expo;

    &.is-revealed {
        opacity: 1;
        transform: translateY(0);
    }
}
</file>

<file path="storage/sass-backup/sass/global/_normalize.scss">
