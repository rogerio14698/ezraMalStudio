<file path="resources/sass/src/_footer.scss">
@use '../global/var' as *;

// ======================= Pie / contacto (layouts/footer.blade.php) =======================
.footer {
    padding-block: clamp(4rem, 8vw, 6.5rem) 2rem;
    background-color: $color-ink;
    color: $color-bg;

    &__grid {
        display: grid;
        grid-template-columns: 1.3fr 0.7fr;
        gap: 3rem;
        padding-bottom: 3.5rem;
        border-bottom: 1px solid rgba($color-bg, 0.14);

        @media (max-width: 768px) {
            grid-template-columns: 1fr;
        }
    }

    &__title {
        margin-bottom: 1rem;
        font-family: $font-display;
        font-size: clamp(2rem, 4vw, 3.2rem);
        font-weight: 400;
        line-height: 1.1;
    }

    &__text {
        max-width: 460px;
        margin-bottom: 2rem;
        color: rgba($color-bg, 0.75);
    }

    &__meta {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }

    &__col h3 {
        margin-bottom: 1rem;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: $color-ochre;
    }

    &__socials a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        color: rgba($color-bg, 0.85);
        transition: color 0.2s ease;

        &:hover {
            color: $color-bg;
            text-decoration: underline;
            text-underline-offset: 4px;
        }
    }

    &__bottom {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.5rem 2rem;
        padding-top: 1.5rem;
        font-size: 0.85rem;
        color: rgba($color-bg, 0.6);
    }
}
</file>

<file path="resources/sass/src/_gallery.scss">
@use '../global/var' as *;

// ======================= Galería (sections/galeria.blade.php) =======================
.gallery {
    background-color: $color-surface-alt;

    &__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-auto-rows: clamp(200px, 22vw, 300px);
        gap: 1rem;
        grid-auto-flow: dense; // rellena huecos al mezclar fotos anchas y normales

        @media (max-width: 768px) {
            grid-template-columns: repeat(2, 1fr);
        }

        @media (max-width: 480px) {
            grid-template-columns: 1fr;
        }
    }

    // Foto que ocupa dos columnas ('ancho' => true en la vista)
    &__item--wide {
        grid-column: span 2;

        @media (max-width: 480px) {
            grid-column: auto;
        }
    }
}
</file>

<file path="resources/sass/src/_hero.scss">
@use '../global/var' as *;

// ======================= Hero (sections/hero.blade.php) =======================
.hero {
    display: flex;
    align-items: center;
    min-height: calc(100svh - 76px); // ocupa la primera pantalla
    padding-block: clamp(2.5rem, 6vw, 5rem);

    &__grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: clamp(2rem, 5vw, 4.5rem);
        align-items: center;

        @media (max-width: 900px) {
            grid-template-columns: 1fr;
        }
    }

    &__eyebrow {
        display: inline-block;
        margin-bottom: 1.25rem;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: $color-terracotta;
    }

    &__title {
        font-family: $font-display;
        font-size: clamp(2.6rem, 5.5vw, 4.4rem);
        font-weight: 400;
        line-height: 1.08;
        letter-spacing: -0.02em;
        margin-bottom: 1.5rem;

        em {
            font-style: italic;
            color: $color-terracotta;
        }
    }

    &__subtitle {
        max-width: 540px;
        margin-bottom: 2rem;
        font-size: clamp(1.05rem, 1.4vw, 1.2rem);
        color: $color-ink-muted;
    }

    &__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 2.5rem;
    }

    // Datos cortos (8 personas, 5+ años...)
    &__facts {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid $color-border;

        dt {
            font-family: $font-display;
            font-size: 2rem;
            line-height: 1;
        }

        dd {
            margin-top: 0.35rem;
            font-size: 0.85rem;
            color: $color-ink-muted;
        }
    }

    &__visual img {
        width: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        //border-radius: $radius-lg;
        box-shadow: 0 10px 20px rgba($color-ink, 0.12);

        @media (max-width: 900px) {
            aspect-ratio: 4 / 3;
        }
    }
}

// ======================= Entrada al cargar la página =======================
// Cualquier elemento con data-enter aparece una sola vez al cargar.
[data-enter] {
    animation: enter 0.9s $ease-out-expo both;

    & + [data-enter] {
        animation-delay: 0.15s;
    }
}

@keyframes enter {
    from {
        opacity: 0;
        transform: translateY(1.25rem);
    }

    to {
        opacity: 1;
        transform: none;
    }
}
</file>

